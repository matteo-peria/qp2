# Default versions used by configure_managed when installing dependencies.
#
# A non-empty GIT_REF selects a Git checkout instead of a release tarball.
# The installer resolves branches such as master to an exact commit and records
# that commit in the managed dependency prefix.

TREXIO_VERSION=2.6.1
TREXIO_GIT_REF=
QMCKL_VERSION=1.1.0
QMCKL_GIT_REF=master
AUTOCONF_VERSION=2.71
CMAKE_VERSION=3.31.10
HDF5_VERSION=1.14.6
OPENBLAS_VERSION=0.3.32
ZEROMQ_VERSION=4.3.5
F77ZMQ_VERSION=4.3.3
ZLIB_VERSION=1.3.1
SIMPLE_GPU_VERSION=1.0.3
