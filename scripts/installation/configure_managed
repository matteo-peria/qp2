#!/bin/bash
#
# Optional managed dependency installer for Quantum Package.
#


export QP_ROOT="$(cd "$(dirname "$0")/../.." ; pwd -P)"
echo "QP_ROOT="$QP_ROOT

CONFIG_STATE_FILE="${QP_ROOT}/etc/last_config.rc"

DEFAULT_TREXIO_VERSION="${TREXIO_VERSION:-}"
DEFAULT_QMCKL_VERSION="${QMCKL_VERSION:-}"
DEFAULT_TREXIO_GIT_REF="${TREXIO_GIT_REF:-}"
DEFAULT_QMCKL_GIT_REF="${QMCKL_GIT_REF:-}"
DEFAULT_HDF5_VERSION="${HDF5_VERSION:-}"
DEFAULT_OPENBLAS_VERSION="${OPENBLAS_VERSION:-}"
DEFAULT_ZEROMQ_VERSION="${ZEROMQ_VERSION:-}"
DEFAULT_F77ZMQ_VERSION="${F77ZMQ_VERSION:-}"
DEFAULT_ZLIB_VERSION="${ZLIB_VERSION:-}"
DEFAULT_SIMPLE_GPU_VERSION="${SIMPLE_GPU_VERSION:-}"

if [[ -f "${QP_ROOT}"/config/dependencies.rc ]] ; then
    source "${QP_ROOT}"/config/dependencies.rc
fi

TREXIO_VERSION="${DEFAULT_TREXIO_VERSION:-${TREXIO_VERSION}}"
QMCKL_VERSION="${DEFAULT_QMCKL_VERSION:-${QMCKL_VERSION}}"
TREXIO_GIT_REF="${DEFAULT_TREXIO_GIT_REF:-${TREXIO_GIT_REF:-}}"
QMCKL_GIT_REF="${DEFAULT_QMCKL_GIT_REF:-${QMCKL_GIT_REF:-}}"
HDF5_VERSION="${DEFAULT_HDF5_VERSION:-${HDF5_VERSION}}"
OPENBLAS_VERSION="${DEFAULT_OPENBLAS_VERSION:-${OPENBLAS_VERSION}}"
ZEROMQ_VERSION="${DEFAULT_ZEROMQ_VERSION:-${ZEROMQ_VERSION}}"
F77ZMQ_VERSION="${DEFAULT_F77ZMQ_VERSION:-${F77ZMQ_VERSION}}"
ZLIB_VERSION="${DEFAULT_ZLIB_VERSION:-${ZLIB_VERSION}}"
SIMPLE_GPU_VERSION="${DEFAULT_SIMPLE_GPU_VERSION:-${SIMPLE_GPU_VERSION}}"

if [[ -z ${TREXIO_VERSION} || -z ${QMCKL_VERSION} || \
          -z ${HDF5_VERSION} || -z ${OPENBLAS_VERSION} || \
          -z ${ZEROMQ_VERSION} || -z ${F77ZMQ_VERSION} || \
          -z ${ZLIB_VERSION} || -z ${SIMPLE_GPU_VERSION} ]] ; then
    echo "$(basename $0): dependency versions must be defined."
    exit 2
fi

function help()
{
    cat <<EOF
Optional managed dependency installer for Quantum Package.

Usage:
  $(basename $0) -c <file>
  $(basename $0) -c <file> -i <package>
  $(basename $0) -h
  $(basename $0) -i <package>
  $(basename $0) -i trexio --with-hdf5 <path>
  $(basename $0) -g [nvidia|intel|none]

Options:
  -c  <file>        Define a COMPILATION configuration file,
                    in "${QP_ROOT}/config/". The selected file is remembered
                    in "${CONFIG_STATE_FILE}".
  -h                Print the HELP message
  -i <package>      INSTALL <package>. Use at your OWN RISK:
                    no support will be provided for the installation of
                    dependencies. When -c is omitted, the remembered
                    configuration file is reused when available.
  -g [nvidia|intel|none]  Choose GPU acceleration
  --with-hdf5 <path>      HDF5 installation prefix to pass to TREXIO when it
                          contains include/hdf5.h. Skip managed HDF5.
  --with-trexio <path>     Use and validate an external TREXIO installation.
  --with-qmckl <path>      Use and validate an external QMCkl installation.
  --trexio-version <ver>   Install a TREXIO release tarball.
  --trexio-ref <ref>       Install TREXIO from a Git branch, tag, or commit.
  --qmckl-version <ver>    Install a QMCkl release tarball.
  --qmckl-ref <ref>        Install QMCkl from a Git branch, tag, or commit.
  --dependency-prefix <path>
                          Install compiled dependencies below this prefix.
                          The default is dependencies/<config-name> inside
                          QP_ROOT.

Example:
  ./scripts/installation/$(basename $0) -c config/gfortran.cfg

Note:
  Users are encouraged to create their own configuration files instead of
  modifying the existing ones.

EOF
    exit
}

function error() {
    >&2 echo "$(basename $0): $@"
    exit 2
}

function canonicalize_external_prefix() {
    local package=$1
    local prefix=$2
    if [[ ! -d ${prefix} ]] ; then
        error "external ${package} prefix ${prefix} is not a directory."
    fi
    (cd "${prefix}" && pwd -P)
}

function execute () {
    local _command
    local _status
    echo "Executing:"
    while read -r line; do
        echo "  " $line
        _command+="${line} ;"
    done
    sleep 1
    echo ""
    printf "\e[0;94m"
    ( eval "set -e ; set -x ; $_command set +x" )
    _status=$?
    printf "\e[m"
    echo ""
    if [[ ${_status} -ne 0 ]] ; then
        exit "${_status}"
    fi
}

function get_config_option() {
    if [[ -z ${CONFIG} ]] ; then
        return 0
    fi

    python3 - "${QP_ROOT}" "${CONFIG}" "$1" <<'PY'
import os
import sys

qp_root, config, option = sys.argv[1:4]
sys.path.insert(0, os.path.join(qp_root, "scripts", "compilation"))

from read_compilation_cfg import get_compilation_option

value = get_compilation_option(config, option).strip()
if value:
    print(value)
PY
}

function find_hdf5_wrapper() {
    local wrapper
    if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
        for wrapper in h5pcc h5cc ; do
            if [[ -x ${EXTERNAL_HDF5_PREFIX}/bin/${wrapper} ]] ; then
                echo "${EXTERNAL_HDF5_PREFIX}/bin/${wrapper}"
                return 0
            fi
        done
        return 0
    fi
    if [[ -n ${H5CC} ]] ; then
        echo "${H5CC}"
        return 0
    fi

    for wrapper in h5pcc h5cc ; do
        wrapper=$(find_exe "${wrapper}")
        if [[ ${wrapper} != $(not_found) ]] ; then
            echo "${wrapper}"
            return 0
        fi
    done
}

function find_hdf5_fortran_wrapper() {
    local wrapper
    if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
        for wrapper in h5pfc h5fc ; do
            if [[ -x ${EXTERNAL_HDF5_PREFIX}/bin/${wrapper} ]] ; then
                echo "${EXTERNAL_HDF5_PREFIX}/bin/${wrapper}"
                return 0
            fi
        done
        not_found
        return 0
    fi
    if [[ -n ${H5FC} ]] ; then
        echo "${H5FC}"
        return 0
    fi
    for wrapper in h5pfc h5fc ; do
        wrapper=$(find_exe "${wrapper}")
        if [[ ${wrapper} != $(not_found) ]] ; then
            echo "${wrapper}"
            return 0
        fi
    done
    not_found
}

PACKAGES=""
CONFIG_FROM_COMMAND=0
EXTERNAL_HDF5_PREFIX=""
EXTERNAL_TREXIO_PREFIX=""
EXTERNAL_QMCKL_PREFIX=""
TREXIO_SOURCE_REQUEST=""
QMCKL_SOURCE_REQUEST=""

ARGS=()
while [[ $# -gt 0 ]] ; do
    case "$1" in
        --with-hdf5=*)
            EXTERNAL_HDF5_PREFIX="${1#*=}"
            ;;
        --with-hdf5)
            shift
            if [[ -z $1 ]] ; then
                error "--with-hdf5 requires a path."
            fi
            EXTERNAL_HDF5_PREFIX="$1"
            ;;
        --with-trexio=*)
            EXTERNAL_TREXIO_PREFIX="${1#*=}"
            ;;
        --with-trexio)
            shift
            if [[ -z $1 ]] ; then
                error "--with-trexio requires a path."
            fi
            EXTERNAL_TREXIO_PREFIX="$1"
            ;;
        --with-qmckl=*)
            EXTERNAL_QMCKL_PREFIX="${1#*=}"
            ;;
        --with-qmckl)
            shift
            if [[ -z $1 ]] ; then
                error "--with-qmckl requires a path."
            fi
            EXTERNAL_QMCKL_PREFIX="$1"
            ;;
        --trexio-version=*)
            TREXIO_VERSION="${1#*=}"
            TREXIO_SOURCE_REQUEST=release
            ;;
        --trexio-version)
            shift
            [[ -n $1 ]] || error "--trexio-version requires a version."
            TREXIO_VERSION="$1"
            TREXIO_SOURCE_REQUEST=release
            ;;
        --trexio-ref=*)
            TREXIO_GIT_REF="${1#*=}"
            TREXIO_SOURCE_REQUEST=git
            ;;
        --trexio-ref)
            shift
            [[ -n $1 ]] || error "--trexio-ref requires a Git reference."
            TREXIO_GIT_REF="$1"
            TREXIO_SOURCE_REQUEST=git
            ;;
        --qmckl-version=*)
            QMCKL_VERSION="${1#*=}"
            QMCKL_SOURCE_REQUEST=release
            ;;
        --qmckl-version)
            shift
            [[ -n $1 ]] || error "--qmckl-version requires a version."
            QMCKL_VERSION="$1"
            QMCKL_SOURCE_REQUEST=release
            ;;
        --qmckl-ref=*)
            QMCKL_GIT_REF="${1#*=}"
            QMCKL_SOURCE_REQUEST=git
            ;;
        --qmckl-ref)
            shift
            [[ -n $1 ]] || error "--qmckl-ref requires a Git reference."
            QMCKL_GIT_REF="$1"
            QMCKL_SOURCE_REQUEST=git
            ;;
        --dependency-prefix=*)
            DEPENDENCY_PREFIX="${1#*=}"
            ;;
        --dependency-prefix)
            shift
            if [[ -z $1 ]] ; then
                error "--dependency-prefix requires a path."
            fi
            DEPENDENCY_PREFIX="$1"
            ;;
        --)
            shift
            while [[ $# -gt 0 ]] ; do
                ARGS+=("$1")
                shift
            done
            break
            ;;
        *)
            ARGS+=("$1")
            ;;
    esac
    shift
done
set -- "${ARGS[@]}"


while getopts "d:c:i:g:h" c ; do
    case "$c" in
        c)
            case "$OPTARG" in
                "") help ; break;;
                *) if [[ -f $OPTARG ]] ; then
                       CONFIG="$(cd "$(dirname "$OPTARG")" ; pwd -P)/$(basename "$OPTARG")"
                       CONFIG_FROM_COMMAND=1
                   else
                       error "error: configuration file $OPTARG not found."
                       exit 1
                   fi
            esac;;
        i)
            case "$OPTARG" in
                "") help ; break;;
                *) PACKAGES="${PACKAGES} $OPTARG"
            esac;;
        g)
            GPU=$OPTARG;;
        h)
            help
            exit 0;;
        *)
            error $(basename $0)": unknown option $c, try -h for help"
            exit 2;;
    esac
done

if [[ ${CONFIG_FROM_COMMAND} = 1 ]] ; then
    printf "CONFIG=%q\n" "${CONFIG}" > "${CONFIG_STATE_FILE}"
elif [[ -f "${CONFIG_STATE_FILE}" ]] ; then
    source "${CONFIG_STATE_FILE}"
    if [[ -n ${CONFIG} ]] ; then
        if [[ -f ${CONFIG} ]] ; then
            echo "Reusing configuration file: ${CONFIG}"
        else
            error "remembered configuration file ${CONFIG} not found. Run $(basename $0) -c <file>."
        fi
    fi
fi

if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
    EXTERNAL_HDF5_PREFIX="$(canonicalize_external_prefix HDF5 \
                "${EXTERNAL_HDF5_PREFIX}")"
fi
if [[ -n ${EXTERNAL_TREXIO_PREFIX} ]] ; then
    EXTERNAL_TREXIO_PREFIX="$(canonicalize_external_prefix TREXIO \
                "${EXTERNAL_TREXIO_PREFIX}")"
fi
if [[ -n ${EXTERNAL_QMCKL_PREFIX} ]] ; then
    EXTERNAL_QMCKL_PREFIX="$(canonicalize_external_prefix QMCkl \
                "${EXTERNAL_QMCKL_PREFIX}")"
fi

# Initialize and update sources only after command-line parsing. In particular,
# --help must remain a local, side-effect-free operation.
git -C "${QP_ROOT}" submodule init
git -C "${QP_ROOT}" submodule update

SYSTEM=$(uname -s)
if [[ ${SYSTEM} = "Linux" ]] ; then
    SYSTEM=""
fi
ARCHITECTURE=$(uname -m)${SYSTEM}
git -C "${QP_ROOT}/external/qp2-dependencies" checkout master
git -C "${QP_ROOT}/external/qp2-dependencies" pull
echo "Architecture: ${ARCHITECTURE}"

# Handle GPU acceleration
rm -f ${QP_ROOT}/src/gpu_arch
rm -f ${QP_ROOT}/src/*/gpu_arch
case "$GPU" in
    amd) # AMD
        echo "Activating AMD GPU acceleration"
        ln -s ${QP_ROOT}/plugins/local/gpu_amd ${QP_ROOT}/src/gpu_arch
        ;;
    intel) # Intel
        echo "Activating Intel GPU acceleration (EXPERIMENTAL)"
        ln -s ${QP_ROOT}/plugins/local/gpu_intel ${QP_ROOT}/src/gpu_arch
        ;;
    nvidia) # Nvidia
        echo "Activating Nvidia GPU acceleration"
        ln -s ${QP_ROOT}/plugins/local/gpu_nvidia ${QP_ROOT}/src/gpu_arch
        ;;
    *) # No Acceleration
        echo "Disabling GPU acceleration"
        ln -s ${QP_ROOT}/plugins/local/gpu_x86 ${QP_ROOT}/src/gpu_arch
        ;;
esac

# Trim leading and trailing spaces
PACKAGES=$(echo $PACKAGES | xargs)

echo "export QP_ROOT=\"$QP_ROOT\"" > ${QP_ROOT}/etc/00.qp_root.rc

source "${QP_ROOT}/scripts/installation/configure_managed_checks.sh"

CONFIG_CC="$(get_config_option CC)"
CONFIG_CXX="$(get_config_option CXX)"
CONFIG_FC="$(get_config_option FC)"
CONFIG_CFLAGS="$(get_config_option CFLAGS)"
CONFIG_FCFLAGS="$(get_config_option FCFLAGS)"
CONFIG_LIB="$(get_config_option LIB)"
CONFIG_LAPACK_LIB="$(get_config_option LAPACK_LIB)"

if [[ -z ${CONFIG_CC} ]] ; then
    CONFIG_CC="${CC:-gcc}"
fi

if [[ -z ${CONFIG_FC} ]] ; then
    CONFIG_FC="${FC:-gfortran}"
fi

CONFIG_NAME="environment"
if [[ -n ${CONFIG} ]] ; then
    CONFIG_NAME="$(basename "${CONFIG}" .cfg)"
fi

if [[ -z ${DEPENDENCY_PREFIX} ]] ; then
    DEPENDENCY_PREFIX="${QP_ROOT}/dependencies/${CONFIG_NAME}"
fi
DEPENDENCY_PREFIX="$(mkdir -p "${DEPENDENCY_PREFIX}" && \
        cd "${DEPENDENCY_PREFIX}" && pwd -P)"
cat > "${DEPENDENCY_PREFIX}/.qp-managed-config" <<EOF
CONFIG=$(printf '%q' "${CONFIG:-}")
CC=$(printf '%q' "${CONFIG_CC}")
CXX=$(printf '%q' "${CONFIG_CXX}")
FC=$(printf '%q' "${CONFIG_FC}")
EOF
DEPENDENCY_RC="${QP_ROOT}/etc/10.dependencies.rc"
DEPENDENCY_SELECTION="${DEPENDENCY_PREFIX}/.qp-managed-dependencies"

CONFIG_TREXIO_VERSION="${TREXIO_VERSION}"
CONFIG_QMCKL_VERSION="${QMCKL_VERSION}"
CONFIG_TREXIO_GIT_REF="${TREXIO_GIT_REF}"
CONFIG_QMCKL_GIT_REF="${QMCKL_GIT_REF}"
REQUESTED_TREXIO_VERSION="${TREXIO_VERSION}"
REQUESTED_QMCKL_VERSION="${QMCKL_VERSION}"
REQUESTED_TREXIO_GIT_REF="${TREXIO_GIT_REF}"
REQUESTED_QMCKL_GIT_REF="${QMCKL_GIT_REF}"

TREXIO_SOURCE=release
QMCKL_SOURCE=release
[[ -n ${CONFIG_TREXIO_GIT_REF} ]] && TREXIO_SOURCE=git
[[ -n ${CONFIG_QMCKL_GIT_REF} ]] && QMCKL_SOURCE=git
TREXIO_RESOLVED_COMMIT=""
QMCKL_RESOLVED_COMMIT=""

if [[ -f ${DEPENDENCY_SELECTION} ]] ; then
    source "${DEPENDENCY_SELECTION}"
fi

case ${TREXIO_SOURCE_REQUEST} in
    release)
        TREXIO_SOURCE=release
        TREXIO_VERSION="${REQUESTED_TREXIO_VERSION}"
        TREXIO_GIT_REF=""
        TREXIO_RESOLVED_COMMIT=""
        ;;
    git)
        TREXIO_SOURCE=git
        TREXIO_GIT_REF="${REQUESTED_TREXIO_GIT_REF}"
        TREXIO_RESOLVED_COMMIT=""
        ;;
esac
case ${QMCKL_SOURCE_REQUEST} in
    release)
        QMCKL_SOURCE=release
        QMCKL_VERSION="${REQUESTED_QMCKL_VERSION}"
        QMCKL_GIT_REF=""
        QMCKL_RESOLVED_COMMIT=""
        ;;
    git)
        QMCKL_SOURCE=git
        QMCKL_GIT_REF="${REQUESTED_QMCKL_GIT_REF}"
        QMCKL_RESOLVED_COMMIT=""
        ;;
esac

function package_requested() {
    case " ${PACKAGES} " in
        *" all "*|*" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

function resolve_git_ref() {
    local repository=$1
    local reference=$2
    local resolved

    if [[ ${reference} =~ ^[0-9a-fA-F]{40}$ ]] ; then
        echo "${reference,,}"
        return 0
    fi
    resolved=$(git ls-remote "${repository}" \
                   "refs/heads/${reference}" | awk 'NR == 1 {print $1}')
    if [[ -z ${resolved} ]] ; then
        resolved=$(git ls-remote "${repository}" \
                       "refs/tags/${reference}^{}" | \
                       awk 'NR == 1 {print $1}')
    fi
    if [[ -z ${resolved} ]] ; then
        resolved=$(git ls-remote "${repository}" \
                       "refs/tags/${reference}" | awk 'NR == 1 {print $1}')
    fi
    if [[ -z ${resolved} && ${reference} = HEAD ]] ; then
        resolved=$(git ls-remote "${repository}" HEAD | \
                       awk 'NR == 1 {print $1}')
    fi
    [[ -n ${resolved} ]] || return 1
    echo "${resolved}"
}

if [[ ${TREXIO_SOURCE} = git && -z ${EXTERNAL_TREXIO_PREFIX} ]] ; then
    if package_requested trexio || package_requested trexio-nohdf5 ; then
        TREXIO_RESOLVED_COMMIT=$(resolve_git_ref \
                                     https://github.com/TREX-CoE/trexio.git \
                                     "${TREXIO_GIT_REF}") || \
            error "unable to resolve TREXIO Git ref ${TREXIO_GIT_REF}."
    elif [[ -z ${TREXIO_RESOLVED_COMMIT} ]] ; then
        error "install TREXIO Git ref ${TREXIO_GIT_REF} with -i trexio."
    fi
fi
if [[ ${QMCKL_SOURCE} = git && -z ${EXTERNAL_QMCKL_PREFIX} ]] ; then
    if package_requested qmckl ; then
        QMCKL_RESOLVED_COMMIT=$(resolve_git_ref \
                                    https://github.com/TREX-CoE/qmckl.git \
                                    "${QMCKL_GIT_REF}") || \
            error "unable to resolve QMCkl Git ref ${QMCKL_GIT_REF}."
    elif [[ -z ${QMCKL_RESOLVED_COMMIT} ]] ; then
        error "install QMCkl Git ref ${QMCKL_GIT_REF} with -i qmckl."
    fi
fi

cat > "${DEPENDENCY_SELECTION}" <<EOF
TREXIO_SOURCE=$(printf '%q' "${TREXIO_SOURCE}")
TREXIO_VERSION=$(printf '%q' "${TREXIO_VERSION}")
TREXIO_GIT_REF=$(printf '%q' "${TREXIO_GIT_REF}")
TREXIO_RESOLVED_COMMIT=$(printf '%q' "${TREXIO_RESOLVED_COMMIT}")
QMCKL_SOURCE=$(printf '%q' "${QMCKL_SOURCE}")
QMCKL_VERSION=$(printf '%q' "${QMCKL_VERSION}")
QMCKL_GIT_REF=$(printf '%q' "${QMCKL_GIT_REF}")
QMCKL_RESOLVED_COMMIT=$(printf '%q' "${QMCKL_RESOLVED_COMMIT}")
EOF

function package_prefix() {
    echo "${DEPENDENCY_PREFIX}/$1-$2"
}

MANAGED_HDF5_PREFIX="$(package_prefix hdf5 "${HDF5_VERSION}")"
TREXIO_SOURCE_ID="${TREXIO_VERSION}"
QMCKL_SOURCE_ID="${QMCKL_VERSION}"
if [[ ${TREXIO_SOURCE} = git ]] ; then
    TREXIO_SOURCE_ID="git-${TREXIO_RESOLVED_COMMIT:0:12}"
fi
if [[ ${QMCKL_SOURCE} = git ]] ; then
    QMCKL_SOURCE_ID="git-${QMCKL_RESOLVED_COMMIT:0:12}"
fi
MANAGED_TREXIO_PREFIX="$(package_prefix trexio "${TREXIO_SOURCE_ID}")"
MANAGED_TREXIO_NOHDF5_PREFIX="$(package_prefix trexio \
        "${TREXIO_SOURCE_ID}-nohdf5")"
MANAGED_QMCKL_PREFIX="$(package_prefix qmckl "${QMCKL_SOURCE_ID}")"

ACTIVE_HDF5_PREFIX="${EXTERNAL_HDF5_PREFIX:-${MANAGED_HDF5_PREFIX}}"
ACTIVE_TREXIO_PREFIX="${EXTERNAL_TREXIO_PREFIX:-${MANAGED_TREXIO_PREFIX}}"
ACTIVE_TREXIO_FALLBACK="${MANAGED_TREXIO_NOHDF5_PREFIX}"
ACTIVE_QMCKL_PREFIX="${EXTERNAL_QMCKL_PREFIX:-${MANAGED_QMCKL_PREFIX}}"
if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
    MANAGED_HDF5_PREFIX=""
fi
if [[ -n ${EXTERNAL_TREXIO_PREFIX} ]] ; then
    MANAGED_TREXIO_PREFIX=""
    MANAGED_TREXIO_NOHDF5_PREFIX=""
    ACTIVE_TREXIO_FALLBACK=""
fi
if [[ -n ${EXTERNAL_QMCKL_PREFIX} ]] ; then
    MANAGED_QMCKL_PREFIX=""
fi

function write_dependency_rc() {
    local config_quoted cc_quoted fc_quoted
    local hdf5_root_quoted trexio_root_quoted trexio_fallback_quoted
    local qmckl_root_quoted managed_hdf5_quoted
    local managed_trexio_quoted managed_trexio_nohdf5_quoted
    local managed_qmckl_quoted external_hdf5_quoted
    local external_trexio_quoted external_qmckl_quoted
    local trexio_source_quoted trexio_ref_quoted trexio_commit_quoted
    local qmckl_source_quoted qmckl_ref_quoted qmckl_commit_quoted
    printf -v config_quoted '%q' "${CONFIG:-}"
    printf -v cc_quoted '%q' "${CONFIG_CC}"
    printf -v fc_quoted '%q' "${CONFIG_FC}"
    printf -v hdf5_root_quoted '%q' "${ACTIVE_HDF5_PREFIX}"
    printf -v trexio_root_quoted '%q' "${ACTIVE_TREXIO_PREFIX}"
    printf -v trexio_fallback_quoted '%q' "${ACTIVE_TREXIO_FALLBACK}"
    printf -v qmckl_root_quoted '%q' "${ACTIVE_QMCKL_PREFIX}"
    printf -v managed_hdf5_quoted '%q' "${MANAGED_HDF5_PREFIX}"
    printf -v managed_trexio_quoted '%q' "${MANAGED_TREXIO_PREFIX}"
    printf -v managed_trexio_nohdf5_quoted '%q' \
           "${MANAGED_TREXIO_NOHDF5_PREFIX}"
    printf -v managed_qmckl_quoted '%q' "${MANAGED_QMCKL_PREFIX}"
    printf -v external_hdf5_quoted '%q' "${EXTERNAL_HDF5_PREFIX}"
    printf -v external_trexio_quoted '%q' "${EXTERNAL_TREXIO_PREFIX}"
    printf -v external_qmckl_quoted '%q' "${EXTERNAL_QMCKL_PREFIX}"
    printf -v trexio_source_quoted '%q' "${TREXIO_SOURCE}"
    printf -v trexio_ref_quoted '%q' "${TREXIO_GIT_REF}"
    printf -v trexio_commit_quoted '%q' "${TREXIO_RESOLVED_COMMIT}"
    printf -v qmckl_source_quoted '%q' "${QMCKL_SOURCE}"
    printf -v qmckl_ref_quoted '%q' "${QMCKL_GIT_REF}"
    printf -v qmckl_commit_quoted '%q' "${QMCKL_RESOLVED_COMMIT}"
    cat > "${DEPENDENCY_RC}" <<EOF
# Generated by scripts/installation/configure_managed.
# Source this file to reuse the QP dependency stack in QP or another program.
export QP_DEPENDENCY_PREFIX="${DEPENDENCY_PREFIX}"
export QP_DEPENDENCY_CONFIG=${config_quoted}
export QP_DEPENDENCY_CC=${cc_quoted}
export QP_DEPENDENCY_FC=${fc_quoted}
export TREXIO_SOURCE=${trexio_source_quoted}
export TREXIO_GIT_REF=${trexio_ref_quoted}
export TREXIO_GIT_COMMIT=${trexio_commit_quoted}
export QMCKL_SOURCE=${qmckl_source_quoted}
export QMCKL_GIT_REF=${qmckl_ref_quoted}
export QMCKL_GIT_COMMIT=${qmckl_commit_quoted}

qp_dep_set_root() {
  if [[ -d "\$2" ]] ; then
    export "\$1=\$2"
  fi
}
qp_dep_set_root ZLIB_ROOT \
  "\${QP_DEPENDENCY_PREFIX}/zlib-${ZLIB_VERSION}"
qp_dep_set_root ZMQ_ROOT \
  "\${QP_DEPENDENCY_PREFIX}/zeromq-${ZEROMQ_VERSION}"
qp_dep_set_root F77ZMQ_ROOT \
  "\${QP_DEPENDENCY_PREFIX}/f77zmq-${F77ZMQ_VERSION}"
qp_dep_set_root GMP_ROOT \
  "\${QP_DEPENDENCY_PREFIX}/gmp-6.1.2"
qp_dep_set_root OPENBLAS_ROOT \
  "\${QP_DEPENDENCY_PREFIX}/openblas-${OPENBLAS_VERSION}"
qp_dep_set_root HDF5_ROOT ${hdf5_root_quoted}
if [[ -d ${trexio_root_quoted} ]] ; then
  export TREXIO_ROOT=${trexio_root_quoted}
else
  qp_dep_set_root TREXIO_ROOT ${trexio_fallback_quoted}
fi
qp_dep_set_root QMCKL_ROOT ${qmckl_root_quoted}
qp_dep_set_root SIMPLE_GPU_ROOT \
  "\${QP_DEPENDENCY_PREFIX}/simple_gpu-${SIMPLE_GPU_VERSION}"
unset -f qp_dep_set_root

for qp_dep_prefix in \
  "\${QP_DEPENDENCY_PREFIX}/zlib-${ZLIB_VERSION}" \
  "\${QP_DEPENDENCY_PREFIX}/zeromq-${ZEROMQ_VERSION}" \
  "\${QP_DEPENDENCY_PREFIX}/f77zmq-${F77ZMQ_VERSION}" \
  "\${QP_DEPENDENCY_PREFIX}/gmp-6.1.2" \
  "\${QP_DEPENDENCY_PREFIX}/openblas-${OPENBLAS_VERSION}" \
  ${managed_hdf5_quoted} \
  ${managed_trexio_nohdf5_quoted} \
  ${managed_trexio_quoted} \
  ${managed_qmckl_quoted} \
  "\${QP_DEPENDENCY_PREFIX}/simple_gpu-${SIMPLE_GPU_VERSION}" \
  ${external_hdf5_quoted} \
  ${external_trexio_quoted} \
  ${external_qmckl_quoted} ; do
  [[ -d "\${qp_dep_prefix}" ]] || continue
  for qp_dep_entry in "bin:PATH" "lib:LD_LIBRARY_PATH" \
                      "lib:LIBRARY_PATH" "lib64:LD_LIBRARY_PATH" \
                      "lib64:LIBRARY_PATH" "include:CPATH" \
                      "lib/pkgconfig:PKG_CONFIG_PATH" \
                      "lib64/pkgconfig:PKG_CONFIG_PATH" ; do
    qp_dep_dir="\${qp_dep_prefix}/\${qp_dep_entry%%:*}"
    qp_dep_var="\${qp_dep_entry##*:}"
    [[ -d "\${qp_dep_dir}" ]] || continue
    case "\${qp_dep_var}" in
      PATH) qp_dep_old="\${PATH:-}" ;;
      LD_LIBRARY_PATH) qp_dep_old="\${LD_LIBRARY_PATH:-}" ;;
      LIBRARY_PATH) qp_dep_old="\${LIBRARY_PATH:-}" ;;
      CPATH) qp_dep_old="\${CPATH:-}" ;;
      PKG_CONFIG_PATH) qp_dep_old="\${PKG_CONFIG_PATH:-}" ;;
    esac
    case ":\${qp_dep_old}:" in
      *":\${qp_dep_dir}:"*) ;;
      *) export "\${qp_dep_var}=\${qp_dep_dir}\${qp_dep_old:+:\${qp_dep_old}}" ;;
    esac
  done
done
unset qp_dep_prefix qp_dep_entry qp_dep_dir qp_dep_var qp_dep_old
EOF
}

