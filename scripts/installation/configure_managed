function resolve_git_ref() {
    local repository=$1
    local reference=$2
    local resolved

    if [[ ${reference} =~ ^[0-9a-fA-F]{40}$ ]] ; then
        echo "${reference,,}"
        return 0
    fi
    resolved=$(git ls-remote "${repository}" \
                   "refs/heads/${reference}" | awk 'NR == 1 {print $1}')
    if [[ -z ${resolved} ]] ; then
        resolved=$(git ls-remote "${repository}" \
                       "refs/tags/${reference}^{}" | \
                       awk 'NR == 1 {print $1}')
    fi
    if [[ -z ${resolved} ]] ; then
        resolved=$(git ls-remote "${repository}" \
                       "refs/tags/${reference}" | awk 'NR == 1 {print $1}')
    fi
    if [[ -z ${resolved} && ${reference} = HEAD ]] ; then
        resolved=$(git ls-remote "${repository}" HEAD | \
                       awk 'NR == 1 {print $1}')
    fi
    [[ -n ${resolved} ]] || return 1
    echo "${resolved}"
}

function version_at_least() {
    local actual=$1
    local required=$2
    [[ -n ${actual} ]] || return 1
    [[ "$(printf '%s\n%s\n' "${required}" "${actual}" | sort -V | head -n 1)" = \
        "${required}" ]]
}

function autoconf_version() {
    local executable version
    executable=$(command -v autoconf 2> /dev/null) || return 1
    version=$(${executable} --version 2> /dev/null | \
        sed -n '1s/.*) //p')
    printf '%s\n' "${version}"
}

function autoconf_is_usable() {
    local version
    version=$(autoconf_version) || return 1
    version_at_least "${version}" "${AUTOCONF_VERSION}"
}

