# Make program believe stdin is a tty
function faketty() {
    script -qfc "$(printf "%q " "$@")" /dev/null
}

function require_git_source_tools() {
    local dependency=$1
    local tool
    local installed_autoconf
    local missing=""
    for tool in git autoreconf automake python3 ; do
        command -v "${tool}" > /dev/null 2>&1 || \
            missing="${missing} ${tool}"
    done
    if ! command -v emacs26 > /dev/null 2>&1 && \
            ! command -v emacs > /dev/null 2>&1 ; then
        missing="${missing} emacs"
    fi
    installed_autoconf=$(autoconf_version || true)
    if ! version_at_least "${installed_autoconf}" "${AUTOCONF_VERSION}" ; then
        missing="${missing} autoconf>=${AUTOCONF_VERSION}"
    fi
    if [[ -n ${missing} ]] ; then
        error "${dependency} Git sources require:${missing}."
    fi
}

