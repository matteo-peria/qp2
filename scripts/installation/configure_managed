#!/bin/bash
#
# Optional managed dependency installer for Quantum Package.
#


export QP_ROOT="$(cd "$(dirname "$0")/../.." ; pwd -P)"
echo "QP_ROOT="$QP_ROOT

CONFIG_STATE_FILE="${QP_ROOT}/etc/last_config.rc"

DEFAULT_TREXIO_VERSION="${TREXIO_VERSION:-}"
DEFAULT_QMCKL_VERSION="${QMCKL_VERSION:-}"
DEFAULT_TREXIO_GIT_REF="${TREXIO_GIT_REF:-}"
DEFAULT_QMCKL_GIT_REF="${QMCKL_GIT_REF:-}"
DEFAULT_HDF5_VERSION="${HDF5_VERSION:-}"
DEFAULT_OPENBLAS_VERSION="${OPENBLAS_VERSION:-}"
DEFAULT_ZEROMQ_VERSION="${ZEROMQ_VERSION:-}"
DEFAULT_F77ZMQ_VERSION="${F77ZMQ_VERSION:-}"
DEFAULT_ZLIB_VERSION="${ZLIB_VERSION:-}"
DEFAULT_SIMPLE_GPU_VERSION="${SIMPLE_GPU_VERSION:-}"

if [[ -f "${QP_ROOT}"/config/dependencies.rc ]] ; then
        source "${QP_ROOT}"/config/dependencies.rc
fi

TREXIO_VERSION="${DEFAULT_TREXIO_VERSION:-${TREXIO_VERSION}}"
QMCKL_VERSION="${DEFAULT_QMCKL_VERSION:-${QMCKL_VERSION}}"
TREXIO_GIT_REF="${DEFAULT_TREXIO_GIT_REF:-${TREXIO_GIT_REF:-}}"
QMCKL_GIT_REF="${DEFAULT_QMCKL_GIT_REF:-${QMCKL_GIT_REF:-}}"
HDF5_VERSION="${DEFAULT_HDF5_VERSION:-${HDF5_VERSION}}"
OPENBLAS_VERSION="${DEFAULT_OPENBLAS_VERSION:-${OPENBLAS_VERSION}}"
ZEROMQ_VERSION="${DEFAULT_ZEROMQ_VERSION:-${ZEROMQ_VERSION}}"
F77ZMQ_VERSION="${DEFAULT_F77ZMQ_VERSION:-${F77ZMQ_VERSION}}"
ZLIB_VERSION="${DEFAULT_ZLIB_VERSION:-${ZLIB_VERSION}}"
SIMPLE_GPU_VERSION="${DEFAULT_SIMPLE_GPU_VERSION:-${SIMPLE_GPU_VERSION}}"

if [[ -z ${TREXIO_VERSION} || -z ${QMCKL_VERSION} || \
      -z ${HDF5_VERSION} || -z ${OPENBLAS_VERSION} || \
      -z ${ZEROMQ_VERSION} || -z ${F77ZMQ_VERSION} || \
      -z ${ZLIB_VERSION} || -z ${SIMPLE_GPU_VERSION} ]] ; then
        echo "$(basename $0): dependency versions must be defined."
        exit 2
fi

function help()
{
    cat <<EOF
Optional managed dependency installer for Quantum Package.

Usage:
  $(basename $0) -c <file>
  $(basename $0) -c <file> -i <package>
  $(basename $0) -h
  $(basename $0) -i <package>
  $(basename $0) -i trexio --with-hdf5 <path>
  $(basename $0) -g [nvidia|intel|none]

Options:
  -c  <file>        Define a COMPILATION configuration file,
                    in "${QP_ROOT}/config/". The selected file is remembered
                    in "${CONFIG_STATE_FILE}".
  -h                Print the HELP message
  -i <package>      INSTALL <package>. Use at your OWN RISK:
                    no support will be provided for the installation of
                    dependencies. When -c is omitted, the remembered
                    configuration file is reused when available.
  -g [nvidia|intel|none]  Choose GPU acceleration
  --with-hdf5 <path>      HDF5 installation prefix to pass to TREXIO when it
                          contains include/hdf5.h. Skip managed HDF5.
  --with-trexio <path>     Use and validate an external TREXIO installation.
  --with-qmckl <path>      Use and validate an external QMCkl installation.
  --trexio-version <ver>   Install a TREXIO release tarball.
  --trexio-ref <ref>       Install TREXIO from a Git branch, tag, or commit.
  --qmckl-version <ver>    Install a QMCkl release tarball.
  --qmckl-ref <ref>        Install QMCkl from a Git branch, tag, or commit.
  --dependency-prefix <path>
                          Install compiled dependencies below this prefix.
                          The default is a versioned stack inside QP_ROOT.

Example:
  ./scripts/installation/$(basename $0) -c config/gfortran.cfg

Note:
  Users are encouraged to create their own configuration files instead of
  modifying the existing ones.

EOF
    exit
}

function error() {
    >&2 echo "$(basename $0): $@"
    exit 2
}

function canonicalize_external_prefix() {
        local package=$1
        local prefix=$2
        if [[ ! -d ${prefix} ]] ; then
                error "external ${package} prefix ${prefix} is not a directory."
        fi
        (cd "${prefix}" && pwd -P)
}

function execute () {
    local _command
    echo "Executing:"
    while read -r line; do
      echo "  " $line
      _command+="${line} ;"
    done
    sleep 1
    echo ""
    printf "\e[0;94m"
    ( eval "set -e ; set -x ; $_command set +x" ) || exit -1
    printf "\e[m"
    echo ""
}

function get_config_option() {
        if [[ -z ${CONFIG} ]] ; then
                return 0
        fi

        python3 - "${QP_ROOT}" "${CONFIG}" "$1" <<'PY'
import os
import sys

qp_root, config, option = sys.argv[1:4]
sys.path.insert(0, os.path.join(qp_root, "scripts", "compilation"))

from read_compilation_cfg import get_compilation_option

value = get_compilation_option(config, option).strip()
if value:
    print(value)
PY
}

function find_hdf5_wrapper() {
        local wrapper
        if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
                for wrapper in h5pcc h5cc ; do
                        if [[ -x ${EXTERNAL_HDF5_PREFIX}/bin/${wrapper} ]] ; then
                                echo "${EXTERNAL_HDF5_PREFIX}/bin/${wrapper}"
                                return 0
                        fi
                done
                return 0
        fi
        if [[ -n ${H5CC} ]] ; then
                echo "${H5CC}"
                return 0
        fi

        for wrapper in h5pcc h5cc ; do
                wrapper=$(find_exe "${wrapper}")
                if [[ ${wrapper} != $(not_found) ]] ; then
                        echo "${wrapper}"
                        return 0
                fi
        done
}

function find_hdf5_fortran_wrapper() {
        local wrapper
        if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
                for wrapper in h5pfc h5fc ; do
                        if [[ -x ${EXTERNAL_HDF5_PREFIX}/bin/${wrapper} ]] ; then
                                echo "${EXTERNAL_HDF5_PREFIX}/bin/${wrapper}"
                                return 0
                        fi
                done
                not_found
                return 0
        fi
        if [[ -n ${H5FC} ]] ; then
                echo "${H5FC}"
                return 0
        fi
        for wrapper in h5pfc h5fc ; do
                wrapper=$(find_exe "${wrapper}")
                if [[ ${wrapper} != $(not_found) ]] ; then
                        echo "${wrapper}"
                        return 0
                fi
        done
        not_found
}

PACKAGES=""
CONFIG_FROM_COMMAND=0
EXTERNAL_HDF5_PREFIX=""
EXTERNAL_TREXIO_PREFIX=""
EXTERNAL_QMCKL_PREFIX=""
TREXIO_SOURCE_REQUEST=""
QMCKL_SOURCE_REQUEST=""

ARGS=()
while [[ $# -gt 0 ]] ; do
    case "$1" in
        --with-hdf5=*)
            EXTERNAL_HDF5_PREFIX="${1#*=}"
            ;;
        --with-hdf5)
            shift
            if [[ -z $1 ]] ; then
                error "--with-hdf5 requires a path."
            fi
            EXTERNAL_HDF5_PREFIX="$1"
            ;;
        --with-trexio=*)
            EXTERNAL_TREXIO_PREFIX="${1#*=}"
            ;;
        --with-trexio)
            shift
            if [[ -z $1 ]] ; then
                error "--with-trexio requires a path."
            fi
            EXTERNAL_TREXIO_PREFIX="$1"
            ;;
        --with-qmckl=*)
            EXTERNAL_QMCKL_PREFIX="${1#*=}"
            ;;
        --with-qmckl)
            shift
            if [[ -z $1 ]] ; then
                error "--with-qmckl requires a path."
            fi
            EXTERNAL_QMCKL_PREFIX="$1"
            ;;
        --trexio-version=*)
            TREXIO_VERSION="${1#*=}"
            TREXIO_SOURCE_REQUEST=release
            ;;
        --trexio-version)
            shift
            [[ -n $1 ]] || error "--trexio-version requires a version."
            TREXIO_VERSION="$1"
            TREXIO_SOURCE_REQUEST=release
            ;;
        --trexio-ref=*)
            TREXIO_GIT_REF="${1#*=}"
            TREXIO_SOURCE_REQUEST=git
            ;;
        --trexio-ref)
            shift
            [[ -n $1 ]] || error "--trexio-ref requires a Git reference."
            TREXIO_GIT_REF="$1"
            TREXIO_SOURCE_REQUEST=git
            ;;
        --qmckl-version=*)
            QMCKL_VERSION="${1#*=}"
            QMCKL_SOURCE_REQUEST=release
            ;;
        --qmckl-version)
            shift
            [[ -n $1 ]] || error "--qmckl-version requires a version."
            QMCKL_VERSION="$1"
            QMCKL_SOURCE_REQUEST=release
            ;;
        --qmckl-ref=*)
            QMCKL_GIT_REF="${1#*=}"
            QMCKL_SOURCE_REQUEST=git
            ;;
        --qmckl-ref)
            shift
            [[ -n $1 ]] || error "--qmckl-ref requires a Git reference."
            QMCKL_GIT_REF="$1"
            QMCKL_SOURCE_REQUEST=git
            ;;
        --dependency-prefix=*)
            DEPENDENCY_PREFIX="${1#*=}"
            ;;
        --dependency-prefix)
            shift
            if [[ -z $1 ]] ; then
                error "--dependency-prefix requires a path."
            fi
            DEPENDENCY_PREFIX="$1"
            ;;
        --)
            shift
            while [[ $# -gt 0 ]] ; do
                ARGS+=("$1")
                shift
            done
            break
            ;;
        *)
            ARGS+=("$1")
            ;;
    esac
    shift
done
set -- "${ARGS[@]}"


while getopts "d:c:i:g:h" c ; do
    case "$c" in
        c)
            case "$OPTARG" in
                "") help ; break;;
                *) if [[ -f $OPTARG ]] ; then
                      CONFIG="$(cd "$(dirname "$OPTARG")" ; pwd -P)/$(basename "$OPTARG")"
                      CONFIG_FROM_COMMAND=1
                   else
                      error "error: configuration file $OPTARG not found."
                      exit 1
                   fi
            esac;;
        i)
            case "$OPTARG" in
                "") help ; break;;
                *) PACKAGES="${PACKAGES} $OPTARG"
            esac;;
        g)
            GPU=$OPTARG;;
        h)
            help
            exit 0;;
        *)
            error $(basename $0)": unknown option $c, try -h for help"
            exit 2;;
    esac
done

if [[ ${CONFIG_FROM_COMMAND} = 1 ]] ; then
        printf "CONFIG=%q\n" "${CONFIG}" > "${CONFIG_STATE_FILE}"
elif [[ -f "${CONFIG_STATE_FILE}" ]] ; then
        source "${CONFIG_STATE_FILE}"
        if [[ -n ${CONFIG} ]] ; then
                if [[ -f ${CONFIG} ]] ; then
                        echo "Reusing configuration file: ${CONFIG}"
                else
                        error "remembered configuration file ${CONFIG} not found. Run $(basename $0) -c <file>."
                fi
        fi
fi

if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
        EXTERNAL_HDF5_PREFIX="$(canonicalize_external_prefix HDF5 \
                "${EXTERNAL_HDF5_PREFIX}")"
fi
if [[ -n ${EXTERNAL_TREXIO_PREFIX} ]] ; then
        EXTERNAL_TREXIO_PREFIX="$(canonicalize_external_prefix TREXIO \
                "${EXTERNAL_TREXIO_PREFIX}")"
fi
if [[ -n ${EXTERNAL_QMCKL_PREFIX} ]] ; then
        EXTERNAL_QMCKL_PREFIX="$(canonicalize_external_prefix QMCkl \
                "${EXTERNAL_QMCKL_PREFIX}")"
fi

# Initialize and update sources only after command-line parsing. In particular,
# --help must remain a local, side-effect-free operation.
git -C "${QP_ROOT}" submodule init
git -C "${QP_ROOT}" submodule update

SYSTEM=$(uname -s)
if [[ ${SYSTEM} = "Linux" ]] ; then
        SYSTEM=""
fi
ARCHITECTURE=$(uname -m)${SYSTEM}
git -C "${QP_ROOT}/external/qp2-dependencies" checkout master
git -C "${QP_ROOT}/external/qp2-dependencies" pull
echo "Architecture: ${ARCHITECTURE}"

# Handle GPU acceleration
rm -f ${QP_ROOT}/src/gpu_arch
rm -f ${QP_ROOT}/src/*/gpu_arch
case "$GPU" in
  amd) # AMD
     echo "Activating AMD GPU acceleration"
     ln -s ${QP_ROOT}/plugins/local/gpu_amd ${QP_ROOT}/src/gpu_arch
     ;;
  intel) # Intel
     echo "Activating Intel GPU acceleration (EXPERIMENTAL)"
     ln -s ${QP_ROOT}/plugins/local/gpu_intel ${QP_ROOT}/src/gpu_arch
     ;;
  nvidia) # Nvidia
     echo "Activating Nvidia GPU acceleration"
     ln -s ${QP_ROOT}/plugins/local/gpu_nvidia ${QP_ROOT}/src/gpu_arch
     ;;
  *) # No Acceleration
     echo "Disabling GPU acceleration"
     ln -s ${QP_ROOT}/plugins/local/gpu_x86 ${QP_ROOT}/src/gpu_arch
     ;;
esac

# Trim leading and trailing spaces
PACKAGES=$(echo $PACKAGES | xargs)

echo "export QP_ROOT=\"$QP_ROOT\"" > ${QP_ROOT}/etc/00.qp_root.rc

function fail() {
        echo "You can try to install it using the -i option."
        echo "Please refer to INSTALL.rst to install the missing dependencies."
        exit -1
}

function success() {
        echo ""
        echo "Configuration successful."
        exit 0
}

function not_found() {
   echo 'not_found'
}

function find_exe() {
        which $1 2> /dev/null || not_found
}

function find_python_lib() {
        python3 -c "import $1" &> /dev/null && echo "$1" || not_found
}

function check_c_program() {
        eval "${CONFIG_CC} ${CONFIG_CFLAGS} \"${QP_ROOT}\"/external/tmp.c -o \"${QP_ROOT}\"/external/tmp.exe ${CONFIG_LIB} $*" 2> /dev/null
        if [[ -x "${QP_ROOT}"/external/tmp.exe ]] && \
           "${QP_ROOT}"/external/tmp.exe 2> /dev/null ; then
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.c
                echo "found"
        else
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.c
                not_found
        fi
}

function check_zeromq() {
        cat > "${QP_ROOT}"/external/tmp.c <<'EOF'
#include <zmq.h>
int main(void) {
  int major, minor, patch;
  zmq_version(&major, &minor, &patch);
  return major < 0;
}
EOF
        check_c_program -lzmq
}

function check_gmp() {
        cat > "${QP_ROOT}"/external/tmp.c <<'EOF'
#include <gmp.h>
int main(void) {
  mpz_t value;
  mpz_init_set_ui(value, 42ul);
  int result = mpz_cmp_ui(value, 42ul);
  mpz_clear(value);
  return result != 0;
}
EOF
        check_c_program -lgmp
}

function check_zlib() {
        cat > "${QP_ROOT}"/external/tmp.c <<'EOF'
#include <zlib.h>
int main(void) {
  return zlibVersion() == 0;
}
EOF
        check_c_program -lz
}

function check_simple_gpu() {
        cat > "${QP_ROOT}"/external/tmp.c <<'EOF'
#include <simple_gpu.h>
int main(void) {
  return gpu_ndevices() < 0;
}
EOF
        check_c_program -lsimple_gpu-cpu
}

function check_trexio() {
        cat > "${QP_ROOT}"/external/tmp.f90 <<'EOF'
program main
  use trexio
  if (.not. trexio_has_back_end(TREXIO_TEXT)) stop 1
end program main
EOF
        eval "${CONFIG_FC} ${CONFIG_FCFLAGS} \"${QP_ROOT}\"/src/trexio/trexio_module.F90 \"${QP_ROOT}\"/external/tmp.f90 -o \"${QP_ROOT}\"/external/tmp.exe ${CONFIG_LIB} -ltrexio" 2> /dev/null
        if [[ -x "${QP_ROOT}"/external/tmp.exe ]] && \
           "${QP_ROOT}"/external/tmp.exe 2> /dev/null ; then
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90 trexio.mod
                echo "found"
        else
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90 trexio.mod
                not_found
        fi
}

function check_qmckl() {
        cat > "${QP_ROOT}"/external/tmp.f90 <<'EOF'
program main
  use qmckl
  integer(qmckl_context) :: context
  integer(qmckl_exit_code) :: rc
  context = qmckl_context_create()
  if (context == QMCKL_NULL_CONTEXT) stop 1
  rc = qmckl_context_destroy(context)
  if (rc /= QMCKL_SUCCESS) stop 2
end program main
EOF
        eval "${CONFIG_FC} ${CONFIG_FCFLAGS} \"${QP_ROOT}\"/plugins/local/qmckl/qmckl.F90 \"${QP_ROOT}\"/external/tmp.f90 -o \"${QP_ROOT}\"/external/tmp.exe ${CONFIG_LIB} ${BLAS_LIBS:-${CONFIG_LAPACK_LIB}} -lqmckl -ltrexio" 2> /dev/null
        if [[ -x "${QP_ROOT}"/external/tmp.exe ]] && \
           "${QP_ROOT}"/external/tmp.exe 2> /dev/null ; then
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90 qmckl.mod \
                      qmckl_constants.mod qmckl_verificarlo_f.mod
                echo "found"
        else
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90 qmckl.mod \
                      qmckl_constants.mod qmckl_verificarlo_f.mod
                not_found
        fi
}

function check_f77zmq() {
        cat > "${QP_ROOT}"/external/tmp.f90 <<'EOF'
program main
  use f77_zmq
  integer :: major, minor, patch, rc
  rc = f77_zmq_version(major, minor, patch)
  if (rc /= 0) stop 1
end program main
EOF
        eval "${CONFIG_FC} ${CONFIG_FCFLAGS} -I\"${QP_ROOT}/src/zmq\" \"${QP_ROOT}/src/zmq/f77_zmq_module.F90\" \"${QP_ROOT}\"/external/tmp.f90 -o \"${QP_ROOT}\"/external/tmp.exe ${CONFIG_LIB} -lf77zmq -lzmq -lpthread" 2> /dev/null
        if [[ -x "${QP_ROOT}"/external/tmp.exe ]] && \
           "${QP_ROOT}"/external/tmp.exe 2> /dev/null ; then
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90 f77_zmq.mod
                echo "found"
        else
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90 f77_zmq.mod
                not_found
        fi
}

function check_openblas() {
        cat > "${QP_ROOT}"/external/tmp.f90 <<'EOF'
program main
  double precision :: a(1,1), b(1,1), c(1,1)
  a = 2.d0
  b = 3.d0
  c = 0.d0
  call dgemm('N', 'N', 1, 1, 1, 1.d0, a, 1, b, 1, 0.d0, c, 1)
  if (abs(c(1,1) - 6.d0) > 1.d-12) stop 1
end program main
EOF
        eval "${CONFIG_FC} ${CONFIG_FCFLAGS} \"${QP_ROOT}\"/external/tmp.f90 -o \"${QP_ROOT}\"/external/tmp.exe ${CONFIG_LIB} -lopenblas" 2> /dev/null
        if [[ -x "${QP_ROOT}"/external/tmp.exe ]] && \
           "${QP_ROOT}"/external/tmp.exe 2> /dev/null ; then
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90
                echo "found"
        else
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90
                not_found
        fi
}

function check_hdf5() {
        local h5fc h5fc_show h5fc_flags
        h5fc=$(find_hdf5_fortran_wrapper)
        if [[ ${h5fc} = $(not_found) ]] ; then
                not_found
                return
        fi
        h5fc_show="$(${h5fc} -show 2> /dev/null)"
        if [[ -z ${h5fc_show} || ${h5fc_show} != *" "* ]] ; then
                not_found
                return
        fi
        h5fc_flags="${h5fc_show#* }"
        cat > "${QP_ROOT}"/external/tmp.f90 <<'EOF'
program main
  use hdf5
  integer :: ierr
  call h5open_f(ierr)
  if (ierr /= 0) stop 1
  call h5close_f(ierr)
  if (ierr /= 0) stop 2
end program main
EOF
        eval "${CONFIG_FC} ${CONFIG_FCFLAGS} \"${QP_ROOT}\"/external/tmp.f90 -o \"${QP_ROOT}\"/external/tmp.exe ${h5fc_flags}" 2> /dev/null
        if [[ -x "${QP_ROOT}"/external/tmp.exe ]] && \
           "${QP_ROOT}"/external/tmp.exe 2> /dev/null ; then
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90
                echo "found"
        else
                rm -f "${QP_ROOT}"/external/tmp.exe \
                      "${QP_ROOT}"/external/tmp.f90
                not_found
        fi
}

function find_dir() {
        if [[ -d $1 ]] ; then
                echo "$1"
        else
                not_found
        fi
}

CONFIG_CC="$(get_config_option CC)"
CONFIG_FC="$(get_config_option FC)"
CONFIG_CFLAGS="$(get_config_option CFLAGS)"
CONFIG_FCFLAGS="$(get_config_option FCFLAGS)"
CONFIG_LIB="$(get_config_option LIB)"
CONFIG_LAPACK_LIB="$(get_config_option LAPACK_LIB)"

if [[ -z ${CONFIG_CC} ]] ; then
        CONFIG_CC="${CC:-gcc}"
fi

if [[ -z ${CONFIG_FC} ]] ; then
        CONFIG_FC="${FC:-gfortran}"
fi

CONFIG_NAME="environment"
if [[ -n ${CONFIG} ]] ; then
        CONFIG_NAME="$(basename "${CONFIG}" .cfg)"
fi
if command -v sha256sum > /dev/null 2>&1 ; then
        HASH_COMMAND="sha256sum"
else
        HASH_COMMAND="shasum -a 256"
fi
CONFIG_HASH="$({
        [[ -n ${CONFIG} ]] && cat "${CONFIG}"
        printf '%s\n' "CC=${CONFIG_CC}" "FC=${CONFIG_FC}"
        "${CONFIG_CC%% *}" --version 2> /dev/null || true
        "${CONFIG_FC%% *}" --version 2> /dev/null || true
        } | ${HASH_COMMAND} | cut -c 1-12)"
STACK_ID="${CONFIG_NAME}-${CONFIG_HASH}"

if [[ -z ${DEPENDENCY_PREFIX} ]] ; then
        DEPENDENCY_PREFIX="${QP_ROOT}/dependencies/${STACK_ID}"
fi
DEPENDENCY_PREFIX="$(mkdir -p "${DEPENDENCY_PREFIX}" && \
        cd "${DEPENDENCY_PREFIX}" && pwd -P)"
STACK_METADATA="${DEPENDENCY_PREFIX}/.qp-managed-stack"
if [[ -f ${STACK_METADATA} ]] ; then
        INSTALLED_STACK_ID="$(cat "${STACK_METADATA}")"
        if [[ ${INSTALLED_STACK_ID} != "${STACK_ID}" ]] ; then
                error "dependency prefix belongs to ${INSTALLED_STACK_ID}, not ${STACK_ID}."
        fi
else
        printf '%s\n' "${STACK_ID}" > "${STACK_METADATA}"
fi
DEPENDENCY_RC="${QP_ROOT}/etc/10.dependencies.rc"
DEPENDENCY_SELECTION="${DEPENDENCY_PREFIX}/.qp-managed-dependencies"

CONFIG_TREXIO_VERSION="${TREXIO_VERSION}"
CONFIG_QMCKL_VERSION="${QMCKL_VERSION}"
CONFIG_TREXIO_GIT_REF="${TREXIO_GIT_REF}"
CONFIG_QMCKL_GIT_REF="${QMCKL_GIT_REF}"
REQUESTED_TREXIO_VERSION="${TREXIO_VERSION}"
REQUESTED_QMCKL_VERSION="${QMCKL_VERSION}"
REQUESTED_TREXIO_GIT_REF="${TREXIO_GIT_REF}"
REQUESTED_QMCKL_GIT_REF="${QMCKL_GIT_REF}"

TREXIO_SOURCE=release
QMCKL_SOURCE=release
[[ -n ${CONFIG_TREXIO_GIT_REF} ]] && TREXIO_SOURCE=git
[[ -n ${CONFIG_QMCKL_GIT_REF} ]] && QMCKL_SOURCE=git
TREXIO_RESOLVED_COMMIT=""
QMCKL_RESOLVED_COMMIT=""

if [[ -f ${DEPENDENCY_SELECTION} ]] ; then
        source "${DEPENDENCY_SELECTION}"
fi

case ${TREXIO_SOURCE_REQUEST} in
        release)
                TREXIO_SOURCE=release
                TREXIO_VERSION="${REQUESTED_TREXIO_VERSION}"
                TREXIO_GIT_REF=""
                TREXIO_RESOLVED_COMMIT=""
                ;;
        git)
                TREXIO_SOURCE=git
                TREXIO_GIT_REF="${REQUESTED_TREXIO_GIT_REF}"
                TREXIO_RESOLVED_COMMIT=""
                ;;
esac
case ${QMCKL_SOURCE_REQUEST} in
        release)
                QMCKL_SOURCE=release
                QMCKL_VERSION="${REQUESTED_QMCKL_VERSION}"
                QMCKL_GIT_REF=""
                QMCKL_RESOLVED_COMMIT=""
                ;;
        git)
                QMCKL_SOURCE=git
                QMCKL_GIT_REF="${REQUESTED_QMCKL_GIT_REF}"
