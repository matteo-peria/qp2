#!/bin/bash
#
# Optional managed dependency installer for Quantum Package.
#


PREVIOUS_QP_ROOT="${QP_ROOT:-}"
PREVIOUS_QP_DEPENDENCY_PREFIX="${QP_DEPENDENCY_PREFIX:-}"
export QP_ROOT="$(cd "$(dirname "$0")/../.." ; pwd -P)"
echo "QP_ROOT="$QP_ROOT

CONFIG_STATE_FILE="${QP_ROOT}/etc/last_config.rc"

DEFAULT_TREXIO_VERSION="${TREXIO_VERSION:-}"
DEFAULT_QMCKL_VERSION="${QMCKL_VERSION:-}"
DEFAULT_CMAKE_VERSION="${CMAKE_VERSION:-}"
DEFAULT_TREXIO_GIT_REF="${TREXIO_GIT_REF:-}"
DEFAULT_QMCKL_GIT_REF="${QMCKL_GIT_REF:-}"
DEFAULT_AUTOCONF_VERSION="${AUTOCONF_VERSION:-}"
DEFAULT_HDF5_VERSION="${HDF5_VERSION:-}"
DEFAULT_OPENBLAS_VERSION="${OPENBLAS_VERSION:-}"
DEFAULT_ZEROMQ_VERSION="${ZEROMQ_VERSION:-}"
DEFAULT_F77ZMQ_VERSION="${F77ZMQ_VERSION:-}"
DEFAULT_ZLIB_VERSION="${ZLIB_VERSION:-}"
DEFAULT_SIMPLE_GPU_VERSION="${SIMPLE_GPU_VERSION:-}"

if [[ -f "${QP_ROOT}"/config/dependencies.rc ]] ; then
    source "${QP_ROOT}"/config/dependencies.rc
fi

TREXIO_VERSION="${DEFAULT_TREXIO_VERSION:-${TREXIO_VERSION}}"
QMCKL_VERSION="${DEFAULT_QMCKL_VERSION:-${QMCKL_VERSION}}"
CMAKE_VERSION="${DEFAULT_CMAKE_VERSION:-${CMAKE_VERSION}}"
TREXIO_GIT_REF="${DEFAULT_TREXIO_GIT_REF:-${TREXIO_GIT_REF:-}}"
QMCKL_GIT_REF="${DEFAULT_QMCKL_GIT_REF:-${QMCKL_GIT_REF:-}}"
AUTOCONF_VERSION="${DEFAULT_AUTOCONF_VERSION:-${AUTOCONF_VERSION}}"
HDF5_VERSION="${DEFAULT_HDF5_VERSION:-${HDF5_VERSION}}"
OPENBLAS_VERSION="${DEFAULT_OPENBLAS_VERSION:-${OPENBLAS_VERSION}}"
ZEROMQ_VERSION="${DEFAULT_ZEROMQ_VERSION:-${ZEROMQ_VERSION}}"
F77ZMQ_VERSION="${DEFAULT_F77ZMQ_VERSION:-${F77ZMQ_VERSION}}"
ZLIB_VERSION="${DEFAULT_ZLIB_VERSION:-${ZLIB_VERSION}}"
SIMPLE_GPU_VERSION="${DEFAULT_SIMPLE_GPU_VERSION:-${SIMPLE_GPU_VERSION}}"

if [[ -z ${TREXIO_VERSION} || -z ${QMCKL_VERSION} || \
          -z ${AUTOCONF_VERSION} || -z ${CMAKE_VERSION} || \
          -z ${HDF5_VERSION} || -z ${OPENBLAS_VERSION} || \
          -z ${ZEROMQ_VERSION} || -z ${F77ZMQ_VERSION} || \
          -z ${ZLIB_VERSION} || -z ${SIMPLE_GPU_VERSION} ]] ; then
    echo "$(basename $0): dependency versions must be defined."
    exit 2
fi

function help()
{
    cat <<EOF
Optional managed dependency installer for Quantum Package.

Usage:
  $(basename $0) -c <file>
  $(basename $0) -c <file> -i <package>
  $(basename $0) -h
  $(basename $0) -i <package>
  $(basename $0) -i trexio --with-hdf5 <path>
  $(basename $0) -g [amd|nvidia|intel|none]

Options:
  -c  <file>        Define a COMPILATION configuration file,
                    in "${QP_ROOT}/config/". The selected file is remembered
                    in "${CONFIG_STATE_FILE}".
  -h                Print the HELP message
  -i <package>      INSTALL <package>. Use at your OWN RISK:
                    no support will be provided for the installation of
                    dependencies. When -c is omitted, the remembered
                    configuration file is reused when available.
  -g [amd|nvidia|intel|none]  Choose GPU acceleration
  --with-hdf5 <path>      HDF5 installation prefix to pass to TREXIO when it
                          contains include/hdf5.h. Skip managed HDF5.
  --with-openblas <path>   Use and validate an external OpenBLAS installation.
                          Skip managed OpenBLAS, including with -i all.
  --with-mkl <path>       Use an external oneMKL root containing include/ and
                          lib/. Record its environment for QP and dependencies.
  --with-trexio <path>     Use and validate an external TREXIO installation.
  --with-qmckl <path>      Use and validate an external QMCkl installation.
  --with-zeromq <path>     Use and validate an external ZeroMQ installation.
  --trexio-version <ver>   Install a TREXIO release tarball.
  --trexio-ref <ref>       Install TREXIO from a Git branch, tag, or commit.
  --qmckl-version <ver>    Install a QMCkl release tarball.
  --qmckl-ref <ref>        Install QMCkl from a Git branch, tag, or commit.
  --dependency-prefix <path>
                          Install compiled dependencies below this prefix.
                          The default is dependencies/<config-name> inside
                          QP_ROOT.

Example:
  ./scripts/installation/$(basename $0) -c config/gfortran.cfg

Note:
  Users are encouraged to create their own configuration files instead of
  modifying the existing ones.

EOF
    exit
}

function error() {
    >&2 echo "$(basename $0): $@"
    exit 2
}

function canonicalize_external_prefix() {
    local package=$1
    local prefix=$2
    if [[ ! -d ${prefix} ]] ; then
        error "external ${package} prefix ${prefix} is not a directory."
    fi
    (cd "${prefix}" && pwd -P)
}

function remove_path_prefix() {
    local variable=$1
    local prefix=$2
    local entry value cleaned=""
    [[ -n ${prefix} ]] || return 0
    value="${!variable:-}"
    while IFS= read -r entry ; do
        [[ -n ${entry} ]] || continue
        case "${entry}" in
            "${prefix}"|"${prefix}"/*) continue ;;
        esac
        cleaned="${cleaned}${cleaned:+:}${entry}"
    done < <(printf '%s' "${value}" | tr ':' '\n')
    export "${variable}=${cleaned}"
}

function execute () {
    local _command
    local _status
    echo "Executing:"
    while read -r line; do
        echo "  " $line
        _command+="${line} ;"
    done
    sleep 1
    echo ""
    printf "\e[0;94m"
    ( set -e ; set -x ; eval "${_command}" )
    _status=$?
    printf "\e[m"
    echo ""
    if [[ ${_status} -ne 0 ]] ; then
        exit "${_status}"
    fi
}

function get_config_option() {
    if [[ -z ${CONFIG} ]] ; then
        return 0
    fi

    python3 - "${QP_ROOT}" "${CONFIG}" "$1" <<'PY'
import os
import sys

qp_root, config, option = sys.argv[1:4]
sys.path.insert(0, os.path.join(qp_root, "scripts", "compilation"))

from read_compilation_cfg import get_compilation_option

value = get_compilation_option(config, option).strip()
if value:
    print(value)
PY
}

function find_hdf5_wrapper() {
    local wrapper
    if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
        for wrapper in h5pcc h5cc ; do
            if [[ -x ${EXTERNAL_HDF5_PREFIX}/bin/${wrapper} ]] ; then
                echo "${EXTERNAL_HDF5_PREFIX}/bin/${wrapper}"
                return 0
            fi
        done
        return 0
    fi
    if [[ -n ${H5CC} ]] ; then
        echo "${H5CC}"
        return 0
    fi

    for wrapper in h5pcc h5cc ; do
        wrapper=$(find_exe "${wrapper}")
        if [[ ${wrapper} != $(not_found) ]] ; then
            echo "${wrapper}"
            return 0
        fi
    done
}

function find_hdf5_fortran_wrapper() {
    local wrapper
    if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
        for wrapper in h5pfc h5fc ; do
            if [[ -x ${EXTERNAL_HDF5_PREFIX}/bin/${wrapper} ]] ; then
                echo "${EXTERNAL_HDF5_PREFIX}/bin/${wrapper}"
                return 0
            fi
        done
        not_found
        return 0
    fi
    if [[ -n ${H5FC} ]] ; then
        echo "${H5FC}"
        return 0
    fi
    for wrapper in h5pfc h5fc ; do
        wrapper=$(find_exe "${wrapper}")
        if [[ ${wrapper} != $(not_found) ]] ; then
            echo "${wrapper}"
            return 0
        fi
    done
    not_found
}

PACKAGES=""
CONFIG_FROM_COMMAND=0
EXTERNAL_HDF5_PREFIX=""
EXTERNAL_OPENBLAS_PREFIX=""
EXTERNAL_MKL_PREFIX=""
EXTERNAL_TREXIO_PREFIX=""
EXTERNAL_QMCKL_PREFIX=""
EXTERNAL_ZEROMQ_PREFIX=""
EXTERNAL_HDF5_FROM_COMMAND=0
EXTERNAL_OPENBLAS_FROM_COMMAND=0
EXTERNAL_MKL_FROM_COMMAND=0
EXTERNAL_TREXIO_FROM_COMMAND=0
EXTERNAL_QMCKL_FROM_COMMAND=0
EXTERNAL_ZEROMQ_FROM_COMMAND=0
TREXIO_SOURCE_REQUEST=""
QMCKL_SOURCE_REQUEST=""

function require_option_argument() {
    local option=$1
    local value=${2:-}
    if [[ -z ${value} || ${value} = -* ]] ; then
        error "${option} requires an argument."
    fi
}

function require_nonempty_option() {
    local option=$1
    local value=$2
    [[ -n ${value} ]] || error "${option} requires a non-empty argument."
}

while [[ $# -gt 0 ]] ; do
    case "$1" in
        -h|--help)
            help
            ;;
        -c)
            require_option_argument "$1" "${2:-}"
            CONFIG=$2
            CONFIG_FROM_COMMAND=1
            shift 2
            ;;
        -c?*)
            CONFIG="${1#-c}"
            CONFIG_FROM_COMMAND=1
            shift
            ;;
        -i)
            require_option_argument "$1" "${2:-}"
            PACKAGES="${PACKAGES} $2"
            shift 2
            ;;
        -i?*)
            PACKAGES="${PACKAGES} ${1#-i}"
            shift
            ;;
        -g)
            require_option_argument "$1" "${2:-}"
            GPU=$2
            shift 2
            ;;
        -g?*)
            GPU="${1#-g}"
            shift
            ;;
        --with-hdf5=*)
            EXTERNAL_HDF5_PREFIX="${1#*=}"
            require_nonempty_option --with-hdf5 "${EXTERNAL_HDF5_PREFIX}"
            EXTERNAL_HDF5_FROM_COMMAND=1
            shift
            ;;
        --with-hdf5)
            require_option_argument "$1" "${2:-}"
            EXTERNAL_HDF5_PREFIX=$2
            EXTERNAL_HDF5_FROM_COMMAND=1
            shift 2
            ;;
        --with-openblas=*)
            EXTERNAL_OPENBLAS_PREFIX="${1#*=}"
            require_nonempty_option --with-openblas \
                                    "${EXTERNAL_OPENBLAS_PREFIX}"
            EXTERNAL_OPENBLAS_FROM_COMMAND=1
            shift
            ;;
        --with-openblas)
            require_option_argument "$1" "${2:-}"
            EXTERNAL_OPENBLAS_PREFIX=$2
            EXTERNAL_OPENBLAS_FROM_COMMAND=1
            shift 2
            ;;
        --with-mkl=*)
            EXTERNAL_MKL_PREFIX="${1#*=}"
            require_nonempty_option --with-mkl "${EXTERNAL_MKL_PREFIX}"
            EXTERNAL_MKL_FROM_COMMAND=1
            shift
            ;;
        --with-mkl)
            require_option_argument "$1" "${2:-}"
            EXTERNAL_MKL_PREFIX=$2
            EXTERNAL_MKL_FROM_COMMAND=1
            shift 2
            ;;
        --with-trexio=*)
            EXTERNAL_TREXIO_PREFIX="${1#*=}"
            require_nonempty_option --with-trexio \
                                    "${EXTERNAL_TREXIO_PREFIX}"
            EXTERNAL_TREXIO_FROM_COMMAND=1
            shift
            ;;
        --with-trexio)
            require_option_argument "$1" "${2:-}"
            EXTERNAL_TREXIO_PREFIX=$2
            EXTERNAL_TREXIO_FROM_COMMAND=1
            shift 2
            ;;
        --with-qmckl=*)
            EXTERNAL_QMCKL_PREFIX="${1#*=}"
            require_nonempty_option --with-qmckl "${EXTERNAL_QMCKL_PREFIX}"
            EXTERNAL_QMCKL_FROM_COMMAND=1
            shift
            ;;
        --with-qmckl)
            require_option_argument "$1" "${2:-}"
            EXTERNAL_QMCKL_PREFIX=$2
            EXTERNAL_QMCKL_FROM_COMMAND=1
            shift 2
            ;;
        --with-zeromq=*)
            EXTERNAL_ZEROMQ_PREFIX="${1#*=}"
            require_nonempty_option --with-zeromq \
                                    "${EXTERNAL_ZEROMQ_PREFIX}"
            EXTERNAL_ZEROMQ_FROM_COMMAND=1
            shift
            ;;
        --with-zeromq)
            require_option_argument "$1" "${2:-}"
            EXTERNAL_ZEROMQ_PREFIX=$2
            EXTERNAL_ZEROMQ_FROM_COMMAND=1
            shift 2
            ;;
        --trexio-version=*)
            TREXIO_VERSION="${1#*=}"
            require_nonempty_option --trexio-version "${TREXIO_VERSION}"
            TREXIO_SOURCE_REQUEST=release
            shift
            ;;
        --trexio-version)
            require_option_argument "$1" "${2:-}"
            TREXIO_VERSION=$2
            TREXIO_SOURCE_REQUEST=release
            shift 2
            ;;
        --trexio-ref=*)
            TREXIO_GIT_REF="${1#*=}"
            require_nonempty_option --trexio-ref "${TREXIO_GIT_REF}"
            TREXIO_SOURCE_REQUEST=git
            shift
            ;;
        --trexio-ref)
            require_option_argument "$1" "${2:-}"
            TREXIO_GIT_REF=$2
            TREXIO_SOURCE_REQUEST=git
            shift 2
            ;;
        --qmckl-version=*)
            QMCKL_VERSION="${1#*=}"
            require_nonempty_option --qmckl-version "${QMCKL_VERSION}"
            QMCKL_SOURCE_REQUEST=release
            shift
            ;;
        --qmckl-version)
            require_option_argument "$1" "${2:-}"
            QMCKL_VERSION=$2
            QMCKL_SOURCE_REQUEST=release
            shift 2
            ;;
        --qmckl-ref=*)
            QMCKL_GIT_REF="${1#*=}"
            require_nonempty_option --qmckl-ref "${QMCKL_GIT_REF}"
            QMCKL_SOURCE_REQUEST=git
            shift
            ;;
        --qmckl-ref)
            require_option_argument "$1" "${2:-}"
            QMCKL_GIT_REF=$2
            QMCKL_SOURCE_REQUEST=git
            shift 2
            ;;
        --dependency-prefix=*)
            DEPENDENCY_PREFIX="${1#*=}"
            require_nonempty_option --dependency-prefix \
                                    "${DEPENDENCY_PREFIX}"
            shift
            ;;
        --dependency-prefix)
            require_option_argument "$1" "${2:-}"
            DEPENDENCY_PREFIX=$2
            shift 2
            ;;
        --)
            shift
            [[ $# -eq 0 ]] || error "unexpected argument: $1"
            ;;
        -*)
            error "unknown option $1; use -h for help."
            ;;
        *)
            error "unexpected argument: $1"
            ;;
    esac
done

if [[ ${CONFIG_FROM_COMMAND} = 1 ]] ; then
    if [[ ! -f ${CONFIG} ]] ; then
        error "configuration file ${CONFIG} not found."
    fi
    CONFIG="$(cd "$(dirname "${CONFIG}")" ; pwd -P)/$(basename "${CONFIG}")"
elif [[ -f "${CONFIG_STATE_FILE}" ]] ; then
    source "${CONFIG_STATE_FILE}"
    if [[ -n ${CONFIG} ]] ; then
        if [[ -f ${CONFIG} ]] ; then
            echo "Reusing configuration file: ${CONFIG}"
        else
            error "remembered configuration file ${CONFIG} not found. Run $(basename $0) -c <file>."
        fi
    fi
fi

# Trim leading and trailing spaces
PACKAGES=$(echo "${PACKAGES}" | xargs)

source "${QP_ROOT}/scripts/installation/configure_managed_checks.sh"

CONFIG_CC="$(get_config_option CC)"
CONFIG_CXX="$(get_config_option CXX)"
CONFIG_FC="$(get_config_option FC)"
CONFIG_CFLAGS="$(get_config_option CFLAGS)"
CONFIG_FCFLAGS="$(get_config_option FCFLAGS)"
CONFIG_LIB="$(get_config_option LIB)"
CONFIG_LAPACK_LIB="$(get_config_option LAPACK_LIB)"

if [[ -z ${CONFIG:-} ]] ; then
    error "no compilation configuration selected; use -c <file>."
fi
if [[ -z ${CONFIG_LAPACK_LIB} ]] ; then
    error "no BLAS/LAPACK libraries are specified by " \
          "${CONFIG:-the environment}. Set LAPACK_LIB in the " \
          "compilation configuration."
fi
if [[ -z ${CONFIG_CC} ]] ; then
    error "CC is not defined in ${CONFIG}."
fi
if [[ -z ${CONFIG_CXX} ]] ; then
    error "CXX is not defined in ${CONFIG}."
fi
if [[ -z ${CONFIG_FC} ]] ; then
    error "FC is not defined in ${CONFIG}."
fi
case "${GPU:-none}" in
    amd|intel|nvidia|none) ;;
    *) error "unknown GPU backend ${GPU}; use nvidia, intel, amd, or none." ;;
esac

CONFIG_NAME="environment"
if [[ -n ${CONFIG} ]] ; then
    CONFIG_NAME="$(basename "${CONFIG}" .cfg)"
fi

if [[ -z ${DEPENDENCY_PREFIX} ]] ; then
    DEPENDENCY_PREFIX="${QP_ROOT}/dependencies/${CONFIG_NAME}"
fi
DEPENDENCY_PREFIX="$(mkdir -p "${DEPENDENCY_PREFIX}" && \
        cd "${DEPENDENCY_PREFIX}" && pwd -P)"
CONFIG_STAMP="${DEPENDENCY_PREFIX}/.qp-managed-config"

function validate_dependency_prefix() {
    local -a saved
    [[ -f ${CONFIG_STAMP} ]] || return 0
    mapfile -t saved < <(bash -c '
        source "$1"
        printf "%s\n" "${QP_MANAGED_CC:-${CC:-}}"
        printf "%s\n" "${QP_MANAGED_CXX:-${CXX:-}}"
        printf "%s\n" "${QP_MANAGED_FC:-${FC:-}}"
        printf "%s\n" "${QP_MANAGED_CFLAGS:-}"
        printf "%s\n" "${QP_MANAGED_FCFLAGS:-}"
        printf "%s\n" "${QP_MANAGED_LAPACK_LIB:-}"
    ' _ "${CONFIG_STAMP}")
    if [[ ${saved[0]:-} != "${CONFIG_CC}" || \
          ${saved[1]:-} != "${CONFIG_CXX}" || \
          ${saved[2]:-} != "${CONFIG_FC}" ]] ; then
        error "dependency prefix ${DEPENDENCY_PREFIX} belongs to a " \
              "different compiler configuration. Use another prefix."
    fi
    if [[ -n ${saved[3]:-} && ${saved[3]} != "${CONFIG_CFLAGS}" ]] || \
       [[ -n ${saved[4]:-} && ${saved[4]} != "${CONFIG_FCFLAGS}" ]] || \
       [[ -n ${saved[5]:-} && ${saved[5]} != "${CONFIG_LAPACK_LIB}" ]] ; then
        error "dependency prefix ${DEPENDENCY_PREFIX} has incompatible " \
              "compiler flags or BLAS/LAPACK libraries. Use another prefix."
    fi
}

validate_dependency_prefix
FINAL_DEPENDENCY_RC="${QP_ROOT}/etc/10.dependencies.rc"
STAGED_DEPENDENCY_RC="${DEPENDENCY_PREFIX}/.qp-managed-active.rc"
DEPENDENCY_RC="${STAGED_DEPENDENCY_RC}"
trap 'rm -f "${STAGED_DEPENDENCY_RC}"' EXIT
DEPENDENCY_SELECTION="${DEPENDENCY_PREFIX}/.qp-managed-dependencies"

CONFIG_TREXIO_VERSION="${TREXIO_VERSION}"
CONFIG_QMCKL_VERSION="${QMCKL_VERSION}"
CONFIG_TREXIO_GIT_REF="${TREXIO_GIT_REF}"
CONFIG_QMCKL_GIT_REF="${QMCKL_GIT_REF}"
REQUESTED_TREXIO_VERSION="${TREXIO_VERSION}"
REQUESTED_QMCKL_VERSION="${QMCKL_VERSION}"
REQUESTED_TREXIO_GIT_REF="${TREXIO_GIT_REF}"
REQUESTED_QMCKL_GIT_REF="${QMCKL_GIT_REF}"
REQUESTED_EXTERNAL_HDF5_PREFIX="${EXTERNAL_HDF5_PREFIX}"
REQUESTED_EXTERNAL_MKL_PREFIX="${EXTERNAL_MKL_PREFIX}"
REQUESTED_EXTERNAL_OPENBLAS_PREFIX="${EXTERNAL_OPENBLAS_PREFIX}"
REQUESTED_EXTERNAL_TREXIO_PREFIX="${EXTERNAL_TREXIO_PREFIX}"
REQUESTED_EXTERNAL_QMCKL_PREFIX="${EXTERNAL_QMCKL_PREFIX}"
REQUESTED_EXTERNAL_ZEROMQ_PREFIX="${EXTERNAL_ZEROMQ_PREFIX}"

TREXIO_SOURCE=release
QMCKL_SOURCE=release
[[ -n ${CONFIG_TREXIO_GIT_REF} ]] && TREXIO_SOURCE=git
[[ -n ${CONFIG_QMCKL_GIT_REF} ]] && QMCKL_SOURCE=git
TREXIO_RESOLVED_COMMIT=""
QMCKL_RESOLVED_COMMIT=""

if [[ -f ${DEPENDENCY_SELECTION} ]] ; then
    source "${DEPENDENCY_SELECTION}"
fi
if [[ ${EXTERNAL_HDF5_FROM_COMMAND} = 1 ]] ; then
    EXTERNAL_HDF5_PREFIX="${REQUESTED_EXTERNAL_HDF5_PREFIX}"
fi
if [[ ${EXTERNAL_OPENBLAS_FROM_COMMAND} = 1 ]] ; then
    EXTERNAL_OPENBLAS_PREFIX="${REQUESTED_EXTERNAL_OPENBLAS_PREFIX}"
fi
if [[ ${EXTERNAL_MKL_FROM_COMMAND} = 1 ]] ; then
    EXTERNAL_MKL_PREFIX="${REQUESTED_EXTERNAL_MKL_PREFIX}"
fi
if [[ ${EXTERNAL_TREXIO_FROM_COMMAND} = 1 ]] ; then
    EXTERNAL_TREXIO_PREFIX="${REQUESTED_EXTERNAL_TREXIO_PREFIX}"
fi
if [[ ${EXTERNAL_QMCKL_FROM_COMMAND} = 1 ]] ; then
    EXTERNAL_QMCKL_PREFIX="${REQUESTED_EXTERNAL_QMCKL_PREFIX}"
fi
if [[ ${EXTERNAL_ZEROMQ_FROM_COMMAND} = 1 ]] ; then
    EXTERNAL_ZEROMQ_PREFIX="${REQUESTED_EXTERNAL_ZEROMQ_PREFIX}"
fi

if [[ -n ${EXTERNAL_HDF5_PREFIX} ]] ; then
    EXTERNAL_HDF5_PREFIX="$(canonicalize_external_prefix HDF5 \
                               "${EXTERNAL_HDF5_PREFIX}")"
fi
if [[ -n ${EXTERNAL_OPENBLAS_PREFIX} ]] ; then
    EXTERNAL_OPENBLAS_PREFIX="$(canonicalize_external_prefix OpenBLAS \
                               "${EXTERNAL_OPENBLAS_PREFIX}")"
    if [[ ${CONFIG_LAPACK_LIB,,} != *openblas* ]] ; then
        error "--with-openblas requires LAPACK_LIB to select OpenBLAS."
    fi
fi
if [[ -n ${EXTERNAL_MKL_PREFIX} ]] ; then
    EXTERNAL_MKL_PREFIX="$(canonicalize_external_prefix oneMKL \
                               "${EXTERNAL_MKL_PREFIX}")"
    if [[ ${CONFIG_LAPACK_LIB,,} != *mkl* ]] ; then
        error "--with-mkl requires LAPACK_LIB to select MKL."
    fi
    if [[ ! -f ${EXTERNAL_MKL_PREFIX}/include/mkl.h ]] || \
       [[ ! -e ${EXTERNAL_MKL_PREFIX}/lib/libmkl_core.so && \
          ! -e ${EXTERNAL_MKL_PREFIX}/lib/intel64/libmkl_core.so ]] ; then
        error "${EXTERNAL_MKL_PREFIX} is not a usable oneMKL root."
    fi
fi
if [[ -n ${EXTERNAL_OPENBLAS_PREFIX} && -n ${EXTERNAL_MKL_PREFIX} ]] ; then
    error "--with-openblas and --with-mkl are mutually exclusive."
fi
if [[ -n ${EXTERNAL_TREXIO_PREFIX} ]] ; then
    EXTERNAL_TREXIO_PREFIX="$(canonicalize_external_prefix TREXIO \
                               "${EXTERNAL_TREXIO_PREFIX}")"
fi
if [[ -n ${EXTERNAL_QMCKL_PREFIX} ]] ; then
    EXTERNAL_QMCKL_PREFIX="$(canonicalize_external_prefix QMCkl \
                               "${EXTERNAL_QMCKL_PREFIX}")"
fi
if [[ -n ${EXTERNAL_ZEROMQ_PREFIX} ]] ; then
    EXTERNAL_ZEROMQ_PREFIX="$(canonicalize_external_prefix ZeroMQ \
                               "${EXTERNAL_ZEROMQ_PREFIX}")"
fi

ACTIVE_LAPACK_LIBS="${CONFIG_LAPACK_LIB}"
ACTIVE_MKLROOT="${EXTERNAL_MKL_PREFIX:-${MKLROOT:-}}"
if [[ -n ${ACTIVE_MKLROOT} ]] ; then
    ACTIVE_LAPACK_LIBS="${ACTIVE_LAPACK_LIBS//\$\{MKLROOT\}/${ACTIVE_MKLROOT}}"
    ACTIVE_LAPACK_LIBS="${ACTIVE_LAPACK_LIBS//\$MKLROOT/${ACTIVE_MKLROOT}}"
fi
if [[ ${ACTIVE_LAPACK_LIBS} = *'$'* ]] ; then
    error "LAPACK_LIB contains an unresolved shell variable: " \
          "${ACTIVE_LAPACK_LIBS}"
fi

for compiler in "${CONFIG_CC%% *}" "${CONFIG_CXX%% *}" \
                "${CONFIG_FC%% *}" ; do
    command -v "${compiler}" > /dev/null 2>&1 || \
        error "compiler ${compiler} from ${CONFIG} is not executable."
done
unset compiler

for package in ${PACKAGES} ; do
    case "${package}" in
        all|armadillo|autoconf|bats|bse|cmake|docopt|f77zmq|gmp|ninja|ocaml|\
        openblas|openorb|qmckl|resultsFile|simple_gpu|trexio|\
        trexio-nohdf5|zeromq|zlib) ;;
        *) error "unknown package ${package}; use -h for help." ;;
    esac
done
unset package
if [[ ${PACKAGES} != all && " ${PACKAGES} " = *" all "* ]] ; then
    error "the all package cannot be combined with another -i package."
fi

case ${TREXIO_SOURCE_REQUEST} in
    release)
        TREXIO_SOURCE=release
        TREXIO_VERSION="${REQUESTED_TREXIO_VERSION}"
        TREXIO_GIT_REF=""
        TREXIO_RESOLVED_COMMIT=""
        ;;
    git)
        TREXIO_SOURCE=git
        TREXIO_GIT_REF="${REQUESTED_TREXIO_GIT_REF}"
        TREXIO_RESOLVED_COMMIT=""
        ;;
esac
case ${QMCKL_SOURCE_REQUEST} in
